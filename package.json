{
  "name": "@repi/app",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Repi \u2014 browser-local reverse-engineering workspace for tablets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ./scripts/ship-licence.mjs",
    "preview": "vite preview --port 4173",
    "build:kuna": "node ./scripts/build-kuna.mjs",
    "build:rasc": "node ./scripts/build-rasc.mjs",
    "check:sandbox": "node ./scripts/run-analysis-check.mjs sandbox-check",
    "check:detect": "node ./scripts/run-analysis-check.mjs detect-check",
    "check:kuna": "node ./scripts/run-analysis-check.mjs kuna-check",
    "check:device": "node ./scripts/device-check.mjs",
    "check:device-tools": "node ./scripts/run-analysis-check.mjs device-tools-check"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@solidjs/web": "2.0.0-rc.8",
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/stream-extra": "^2.6.0",
    "fflate": "^0.8.3",
    "highlight.js": "11.11.1",
    "markdown-it": "14.3.2",
    "quickjs-emscripten": "^0.32.0",
    "solid-js": "2.0.0-rc.8",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-solid": "3.0.0-next.27"
  },
  "engines": {
    "node": ">=22.19"
  }
}
