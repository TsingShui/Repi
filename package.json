    "@earendil-works/pi-ai": "0.85.1",
    "@solidjs/web": "2.0.0-rc.8",
    "highlight.js": "11.11.1",
    "markdown-it": "14.3.2",
    "solid-js": "2.0.0-rc.8",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vite-plugin-solid": "3.0.0-next.27"
  },
  "engines": {
    "node": ">=22.19"
  }
